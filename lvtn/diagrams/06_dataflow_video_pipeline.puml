@startuml dataflow_video_pipeline
!theme plain
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam SequenceArrowThickness 1.5
skinparam SequenceParticipantBorderColor #555555
skinparam SequenceLifeLineBorderColor #999999

title Luồng dữ liệu: Video Processing Pipeline\n(Upload -> Transcript -> Segment -> Vector Index)

actor "Giảng viên" as GV
participant "Next.js UI\n(web-bff)" as Web
participant "core-api" as Core
database "PostgreSQL\nSource of Truth" as PG
participant "MinIO\nvideos / video-clips" as MinIO
queue "Redis\nBullMQ + Pub/Sub" as Redis
participant "video-worker\n(Go)" as VideoWorker
participant "FFmpeg" as FFmpeg
participant "Whisper STT" as Whisper
participant "document-worker" as DocWorker
participant "BGE-M3\nEmbedder" as Embedder
database "Qdrant\nlearning_chunks" as Qdrant

== 1. Upload video ==
GV -> Web : Chọn video bài giảng
Web -> Core : POST /videos/upload-session\n(course_id, metadata)
Core -> PG : INSERT videos\n(status=UPLOADING)
Core -> MinIO : Tạo presigned PUT URL\n(bucket: videos)
Core --> Web : {video_id, upload_url}
Web -> MinIO : PUT video trực tiếp
Web -> Core : POST /videos/{id}/confirm-upload
Core -> PG : UPDATE videos\nstatus=UPLOADED
Core -> Redis : publish/job VideoUploaded
Core --> Web : {status=QUEUED}

== 2. Xử lý media trong Go worker ==
VideoWorker -> Redis : consume VideoUploaded
VideoWorker -> PG : UPDATE status=PROCESSING\nprogress=...
VideoWorker -> MinIO : GET raw video
VideoWorker -> FFmpeg : extract_audio(video)
FFmpeg --> VideoWorker : audio_bytes
VideoWorker -> Whisper : transcribe(audio)\nword/segment timestamps
Whisper --> VideoWorker : transcript_segments[]
VideoWorker -> VideoWorker : segment_by_topic_shift\n+ normalize timestamps

== 3. Clip và ghi metadata ==
loop mỗi segment
    VideoWorker -> FFmpeg : cut(video, start_ms, end_ms)
    FFmpeg --> VideoWorker : clip_bytes
    VideoWorker -> MinIO : PUT clip\n(bucket: video-clips)
end
VideoWorker -> PG : INSERT video_segments,\ntranscript_segments
VideoWorker -> Redis : publish TranscriptReady

note right of Redis
  video-worker không gọi trực tiếp
  Python worker. Kết quả đi qua
  PostgreSQL + BullMQ event.
end note

== 4. Nhúng vector transcript ==
DocWorker -> Redis : consume TranscriptReady
DocWorker -> PG : SELECT transcript_segments
DocWorker -> Embedder : embed(transcript text)
Embedder --> DocWorker : dense_vectors[1024]
DocWorker -> Qdrant : upsert points\npayload={video_id, segment_id,\ncourse_id, start_ms, end_ms,\nsource_type="video"}
DocWorker -> PG : UPDATE videos\nstatus=INDEXED
DocWorker -> Redis : publish VideoIndexed

note right of Redis
  VideoIndexed là sự kiện biên.
  Các pipeline hạ nguồn dùng
  transcript đã index khi cần.
end note

== 5. Cập nhật giao diện ==
Redis --> Web : BullMQ events / PubSub\nprogress + status
Web --> GV : SSE/WebSocket update\nstatus=INDEXED

@enduml
