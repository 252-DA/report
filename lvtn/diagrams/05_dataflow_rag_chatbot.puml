@startuml dataflow_rag_chatbot
!theme plain
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam SequenceArrowThickness 1.5
skinparam SequenceParticipantBorderColor #555555
skinparam SequenceLifeLineBorderColor #999999

title Luồng dữ liệu: RAG Chatbot Pipeline\n(Hybrid Retrieval + Graph-aware Reranking + SSE)

actor "Học viên" as HV
participant "Next.js UI\n(web-bff)" as Web
participant "chat-service" as Chat
participant "BGE-M3\nEmbedder" as Embedder
database "Qdrant\nlearning_chunks" as Qdrant
database "Neo4j\nKnowledge Graph" as Neo4j
participant "RRF + Graph-aware\nReranker" as Reranker
participant "LLM API\nGemini/Provider Adapter" as LLM
database "PostgreSQL\nchat_messages" as PG

HV -> Web : Gửi câu hỏi\n(question, session)
Web -> Web : Kiểm tra LTI session\ncourse_id + role
Web -> Chat : SendMessage\n{question, course_id, user_id}

== 1. Query embeddings ==
Chat -> Embedder : embed_dense_and_sparse(question)
Embedder --> Chat : dense_vector[1024]\n+sparse lexical weights

== 2. Hybrid retrieval trên Qdrant ==
Chat -> Qdrant : dense search\nfilter={course_id}\ntop_k=N
Qdrant --> Chat : dense_results[]
Chat -> Qdrant : sparse search\nfilter={course_id}\ntop_k=N
Qdrant --> Chat : sparse_results[]

== 3. RRF fusion ==
Chat -> Reranker : reciprocal_rank_fusion\n(dense_results, sparse_results)
Reranker --> Chat : fused_candidates[]

== 4. Graph-aware reranking ==
Chat -> Neo4j : MATCH LO/Chapter/Concept context\nfor course_id + candidate chunks
Neo4j --> Chat : graph_context\n{lo, chapter, concept, paths}
Chat -> Reranker : boost_by_graph_context\n(candidates, graph_context)
Reranker --> Chat : final_context[]

note right of Reranker
  Boost các chunk:
  - thuộc LO trọng tâm
  - nằm gần Chapter hiện tại
  - có concept/prerequisite liên đới
end note

== 5. LLM streaming generation ==
Chat -> LLM : generate_stream\n(system guardrail,\nquestion, final_context)
LLM --> Chat : token stream\n+ citations metadata
Chat --> Web : SSE token stream\nanswer + citations
Web --> HV : Câu trả lời realtime\nkèm nguồn tham chiếu

== 6. Audit và lịch sử học tập ==
Chat -> PG : INSERT chat_messages\n{question, answer,\nchunks_used, course_id}

note over Chat, LLM
  Cùng pipeline retrieval này được tái sử dụng cho
  AI Tutor Chatbot, sinh quiz theo LO và lesson summary có grounding.
end note

@enduml
