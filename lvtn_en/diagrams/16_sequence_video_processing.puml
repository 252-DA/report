@startuml seq_video_processing
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam SequenceArrowThickness 1.5

title Sequence: Upload and Process Video\n(Video -> TranscriptReady -> Qdrant + Neo4j -> VideoIndexed)

actor "Instructor" as Instructor
participant "web-bff\n(Next.js)" as Web
participant "core-api" as Core
database "PostgreSQL" as PG
participant "MinIO\nObject Storage" as MinIO
queue "Redis\nBullMQ + Pub/Sub" as Redis
participant "video-worker\n(Go)" as VideoWorker
participant "FFmpeg" as FFmpeg
participant "Whisper\nSTT" as Whisper
participant "Segmenter" as Segmenter
participant "document-worker" as DocWorker
participant "BGE-M3\nEmbedder" as Embedder
database "Qdrant\nlearning_chunks" as Qdrant
participant "Outbox Poller\n(in core-api)" as Outbox
database "Neo4j\nKnowledge Graph" as Neo4j

== Upload session ==
Instructor -> Web : choose video
Web -> Core : POST /videos/upload-session\n(course_id, file metadata)
Core -> PG : INSERT videos status=UPLOADING
Core -> MinIO : create presigned PUT URL
Core --> Web : {video_id, upload_url}
Web -> MinIO : PUT raw video
Web -> Core : POST /videos/{id}/confirm-upload
Core -> PG : UPDATE videos status=QUEUED
Core -> Redis : enqueue VideoUploaded
Core --> Web : {status=QUEUED}

== Transcribing (audio extract + STT in one stage) ==
VideoWorker -> Redis : consume VideoUploaded
VideoWorker -> PG : UPDATE status=TRANSCRIBING
VideoWorker -> MinIO : GET raw video
VideoWorker -> FFmpeg : extract_audio(video)
FFmpeg --> VideoWorker : audio file
VideoWorker -> Whisper : transcribe(audio)
Whisper --> VideoWorker : transcript segments\nwith timestamps

== Segment artifacts ==
VideoWorker -> PG : UPDATE status=SEGMENTING
VideoWorker -> Segmenter : detect_segments(transcript,\nsilence + topic shift)
Segmenter --> VideoWorker : video_segments[]
VideoWorker -> FFmpeg : cut clips + thumbnails
FFmpeg --> VideoWorker : segment artifacts
VideoWorker -> MinIO : PUT clips / thumbnails
VideoWorker -> PG : INSERT video_segments\nINSERT transcript_segments
VideoWorker -> Redis : publish TranscriptReady

== Source transaction (PG commit FIRST) ==
DocWorker -> Redis : consume TranscriptReady
DocWorker -> PG : SELECT transcript_segments\nWHERE video_id = id
DocWorker -> PG : UPDATE status=EMBEDDING
DocWorker -> Embedder : embed(transcript_segments[].text)
Embedder --> DocWorker : dense_vectors[1024]
DocWorker -> PG : BEGIN\nUPDATE transcript_segments\nINSERT outbox_events (SegmentIndexed)\nCOMMIT

== Upsert Qdrant (after PG commit, idempotent) ==
DocWorker -> Qdrant : upsert points (idempotent UUIDv7)\npayload={course_id, video_id,\nsegment_id, start_ms, end_ms,\nsource_type=video}

== Async Neo4j graph projection ==
Outbox -> PG : SELECT pending outbox_events
Outbox -> Redis : enqueue GraphSyncRequested
DocWorker -> Redis : consume GraphSyncRequested
DocWorker -> Neo4j : MERGE VideoSegment nodes\nMERGE SUPPORTS -> LearningOutcome
DocWorker -> PG : UPDATE outbox_events status=PROCESSED\nUPDATE videos status=INDEXED
DocWorker -> Redis : publish VideoIndexed\n{video_id, course_id}

== Progress UI ==
Redis --> Web : progress events\nTRANSCRIBING -> SEGMENTING -> EMBEDDING -> INDEXED
Web --> Instructor : SSE update

note over VideoWorker, DocWorker
  Video pipeline produces transcripts, segments, vector index, and graph projection.
  Same canonical pattern as document pipeline; differs only in payload
  (video_id / segment_id vs document_id / chunk_id) and event name (VideoIndexed).
end note

@enduml
