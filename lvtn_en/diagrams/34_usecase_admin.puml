@startuml usecase_admin
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam UsecaseBackgroundColor #EBF5FB
skinparam UsecaseBorderColor #555555
skinparam ActorBorderColor #555555
skinparam PackageBorderColor #888888
skinparam ranksep 18
skinparam nodesep 14

title System Administrator Use Case View

left to right direction

actor "System\nAdministrator\n(AC-05)" as Admin

rectangle "AI Extension System" {

    package "Governance and Operations" #FADBD8 {
        usecase "UC-AD-01\nManage AI Limits" as UC_Quota
        usecase "UC-AD-02\nMonitor System" as UC_Ops
        usecase "UC-AD-03\nConfigure LMS\nIntegration" as UC_LMSConfig
    }
}

actor "Canvas LMS\n(AC-03)" as Canvas

Admin --> UC_Quota
Admin --> UC_Ops
Admin --> UC_LMSConfig
Canvas <-- UC_LMSConfig

@enduml
