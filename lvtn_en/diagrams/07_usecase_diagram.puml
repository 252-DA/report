@startuml usecase_diagram
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam UsecaseBackgroundColor #EBF5FB
skinparam UsecaseBorderColor #555555
skinparam ActorBorderColor #555555
skinparam PackageBorderColor #888888
skinparam ranksep 18
skinparam nodesep 14

title Use Case Diagram - LMS Generative AI System

left to right direction

' ===== Primary actors on the LEFT =====
actor "Instructor\n(AC-01)" as Instructor
actor "Learner\n(AC-02)" as Learner
actor "System\nAdministrator\n(AC-05)" as Admin

rectangle "AI Extension System" {

    package "Access and LMS Integration" #DDEBF7 {
        usecase "UC-LMS-01\nLTI Launch" as UC_Launch
        usecase "UC-LMS-02\nDeep Linking" as UC_DeepLink
        usecase "UC-LMS-03\nScore\nSynchronization" as UC_AGS
    }

    together {
        package "AI-assisted Authoring" #FEF9E7 {
            usecase "UC-IN-01\nUpload Learning\nResources" as UC_Upload
            usecase "UC-IN-02\nMonitor\nProcessing" as UC_Watch
            usecase "UC-IN-03\nReview\nAI Content" as UC_Review
            usecase "UC-IN-04\nPublish Learning\nResources" as UC_Publish
            usecase "UC-IN-05\nView Class\nAnalytics" as UC_Analytics
            usecase "UC-IN-06\nManage Learning\nResources" as UC_Manage
        }

        package "Learner Experience" #E8F5E9 {
            usecase "UC-LE-01\nLearn Micro-Content\nand Videos" as UC_Learn
            usecase "UC-LE-02\nReview with\nFlashcards" as UC_Flash
            usecase "UC-LE-03\nTake Quizzes" as UC_Quiz
            usecase "UC-LE-04\nAsk AI Tutor" as UC_Chat
            usecase "UC-LE-05\nView Personal\nProgress" as UC_Progress
            usecase "UC-LE-06\nSearch Course\nContent" as UC_Search
        }
    }

    package "Governance and Operations" #FADBD8 {
        usecase "UC-AD-01\nManage AI Limits" as UC_Quota
        usecase "UC-AD-02\nMonitor System" as UC_Ops
        usecase "UC-AD-03\nConfigure LMS\nIntegration" as UC_LMSConfig
    }
}

' ===== External systems on the RIGHT =====
actor "Canvas LMS\n(AC-03)" as Canvas
actor "LLM Provider\nGemini (AC-04)" as LLM

' ===== Primary actor associations =====
Instructor --> UC_Upload
Instructor --> UC_Watch
Instructor --> UC_Review
Instructor --> UC_Publish
Instructor --> UC_Analytics
Instructor --> UC_Manage
Instructor --> UC_DeepLink

Learner --> UC_Learn
Learner --> UC_Flash
Learner --> UC_Quiz
Learner --> UC_Chat
Learner --> UC_Progress
Learner --> UC_Search

Admin --> UC_Quota
Admin --> UC_Ops
Admin --> UC_LMSConfig

' ===== External-system associations =====
Canvas --> UC_Launch
Canvas <-- UC_AGS
Canvas <-- UC_LMSConfig
LLM <-- UC_Review
LLM <-- UC_Chat

' ===== Standard UML relationship =====
' Only the conditional extend is kept. Progress update, RAG retrieval,
' LLM calls and job-queue sync are internal behaviour -> sequence/dataflow
' diagrams, not use-case relationships.
' Extend arrow points FROM the extension (Score Sync) TO the base (Take Quizzes).
UC_AGS ..> UC_Quiz : <<extend>>
note on link
  <b>condition:</b> {quiz is gradable
  AND LTI AGS line item configured}
  <b>extension point:</b> ScoreFinalized
end note

note bottom of Canvas
  Canvas is the LMS platform: it initiates
  UC-LMS-01 (LTI Launch) and receives scores
  from UC-LMS-03 (AGS).
end note

note bottom of LLM
  LLM Provider is a supporting external system
  used by Review (selective regeneration) and
  Ask AI Tutor (RAG answer).
end note

@enduml
